# Copy to .env for local overrides. Never commit .env – it is git-ignored.

# Quote form endpoint – only to override the default <CMS_AUTH_URL>/ajanlatkeres
PUBLIC_FORM_ENDPOINT=

# Site URL / base path – only needed for previews (production defaults to https://www.nhcargo.hu and /)
#   GitHub Pages:   SITE_URL=https://<user>.github.io  BASE_PATH=/nhcargo-website
SITE_URL=
BASE_PATH=

# true = preview build: noindex meta on every page + robots.txt closed
PUBLIC_NOINDEX=

# Our backend (cms-auth/: admin login + quote form) – only if Render gave it a different URL
#   CMS_AUTH_URL=https://nhcargo-cms-auth.onrender.com
CMS_AUTH_URL=

# ---- cms-auth/ (set on the Render service nhcargo-cms-auth, not here) ----
# GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET   GitHub OAuth App for the admin login (DEPLOY.md)
# MS_CLIENT_SECRET                         quote form via Microsoft 365; the other form settings are in the admin (M365_BEALLITAS.md)
# ALLOWED_ORIGINS                          https://www.nhcargo.hu,https://nhcargo-website.onrender.com
