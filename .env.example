# Copy to .env for local overrides. Never commit .env – it is git-ignored.

# Contact form endpoint used at build time (overrides src/data/site.ts → formEndpoint)
#   Formspree:       PUBLIC_FORM_ENDPOINT=https://formspree.io/f/abcdwxyz
PUBLIC_FORM_ENDPOINT=

# Site URL / base path – only needed for previews (production defaults to https://www.nhcargo.hu and /)
#   GitHub Pages:   SITE_URL=https://<user>.github.io  BASE_PATH=/nhcargo-website
SITE_URL=
BASE_PATH=

# true = preview build: noindex meta on every page + robots.txt closed
PUBLIC_NOINDEX=
