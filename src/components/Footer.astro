---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { localePath, useTranslations, type Lang } from '../i18n';
import { site, formatAddress } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const navKeys = ['home', 'services', 'sustainability', 'about', 'contact'] as const;
const serviceKeys = ['domestic', 'crossdock', 'international'] as const;
const legalKeys = ['imprint', 'privacy', 'cookies'] as const;
const linkClass = 'text-ink-300 transition-colors hover:text-gold-300';
const headingClass = 'font-display text-sm font-semibold tracking-wider text-white uppercase';
---

<footer class="bg-ink-900 text-ink-200">
  <div class="container-page grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="sm:col-span-2 lg:col-span-3">
      <a href={localePath('home', lang)} class="inline-block rounded-md" aria-label={t.nav.homeLink}>
        <Logo size="md" />
      </a>
      <p class="mt-6 max-w-xs text-sm leading-relaxed text-ink-300">{t.footer.tagline}</p>
      <a
        href={site.social.linkedin}
        class="mt-6 inline-flex size-10 items-center justify-center rounded-full border border-white/15 text-ink-200 transition hover:border-gold-400 hover:text-gold-300"
        rel="noopener"
        target="_blank"
      >
        <Icon name="linkedin" class="size-[18px]" />
        <span class="sr-only">{t.footer.linkedin}</span>
      </a>
    </div>

    <nav aria-labelledby="footer-nav-title" class="lg:col-span-2">
      <h2 id="footer-nav-title" class={headingClass}>{t.footer.navTitle}</h2>
      <ul class="mt-5 space-y-3 text-sm">
        {
          navKeys.map((key) => (
            <li>
              <a href={localePath(key, lang)} class={linkClass}>
                {t.nav[key]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="footer-services-title" class="lg:col-span-2">
      <h2 id="footer-services-title" class={headingClass}>{t.nav.services}</h2>
      <ul class="mt-5 space-y-3 text-sm">
        {
          serviceKeys.map((key) => (
            <li>
              <a href={localePath(key, lang)} class={linkClass}>
                {t.nav[key]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="lg:col-span-3">
      <h2 class={headingClass}>{t.footer.contactTitle}</h2>
      <ul class="mt-5 space-y-4 text-sm">
        <li class="flex gap-3">
          <Icon name="phone" class="mt-0.5 size-4 shrink-0 text-gold-400" />
          <a href={site.phone.href} class="text-ink-200 transition-colors hover:text-gold-300">{site.phone.display}</a>
        </li>
        <li class="flex gap-3">
          <Icon name="mail" class="mt-0.5 size-4 shrink-0 text-gold-400" />
          <a href={`mailto:${site.email}`} class="text-ink-200 transition-colors hover:text-gold-300">{site.email}</a>
        </li>
        <li class="flex gap-3">
          <Icon name="mapPin" class="mt-0.5 size-4 shrink-0 text-gold-400" />
          <span>
            <span class="block text-xs font-semibold tracking-wide text-ink-300 uppercase">{t.footer.office}</span>
            <span class="text-ink-200">{formatAddress(site.office)}</span>
          </span>
        </li>
        <li class="flex gap-3">
          <Icon name="building" class="mt-0.5 size-4 shrink-0 text-gold-400" />
          <span>
            <span class="block text-xs font-semibold tracking-wide text-ink-300 uppercase">{t.footer.seat}</span>
            <span class="text-ink-200">{formatAddress(site.seat)}</span>
          </span>
        </li>
      </ul>
    </div>

    <nav aria-labelledby="footer-legal-title" class="lg:col-span-2">
      <h2 id="footer-legal-title" class={headingClass}>{t.footer.legalTitle}</h2>
      <ul class="mt-5 space-y-3 text-sm">
        {
          legalKeys.map((key) => (
            <li>
              <a href={localePath(key, lang)} class={linkClass}>
                {t.nav[key]}
              </a>
            </li>
          ))
        }
        <li>
          <button type="button" class:list={[linkClass, 'cursor-pointer text-left underline-offset-4 hover:underline']} data-cookie-settings>
            {t.footer.cookieSettings}
          </button>
        </li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-2 py-6 text-xs text-ink-300 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name} {t.footer.rights}</p>
      <p class="font-display tracking-[0.2em] text-gold-400 uppercase">{site.tagline}</p>
    </div>
  </div>
</footer>
