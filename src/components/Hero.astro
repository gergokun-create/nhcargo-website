---
/**
 * Hero banner.
 *  - variant "home": full-height hero with CTAs, cargo chips and key figures
 *  - variant "page": compact hero for inner pages
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  variant?: 'home' | 'page';
  eyebrow: string;
  title: string;
  subtitle: string;
  image: ImageMetadata;
  imageAlt: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  chips?: string[];
  stats?: { value: string; label: string }[];
}

const {
  variant = 'page',
  eyebrow,
  title,
  subtitle,
  image,
  imageAlt,
  primaryCta,
  secondaryCta,
  chips = [],
  stats = [],
} = Astro.props;
const isHome = variant === 'home';
const chipIcons = ['snowflake', 'thermometer', 'leaf', 'truck'] as const;
---

<section
  class:list={[
    'relative isolate overflow-hidden bg-ink-900 text-white',
    isHome ? 'min-h-[min(92vh,860px)] lg:min-h-[min(88vh,900px)]' : '',
  ]}
>
  <Image
    src={image}
    alt={imageAlt}
    widths={[640, 960, 1280, 1600, 1920]}
    sizes="100vw"
    format="webp"
    quality={52}
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
  />
  <!-- Cool-toned overlay for legibility -->
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-ink-950/95 via-ink-900/80 to-cold-800/40"
    aria-hidden="true"
  >
  </div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-t from-ink-950/70 to-transparent" aria-hidden="true">
  </div>

  <div
    class:list={[
      'container-page relative flex flex-col justify-center',
      isHome ? 'min-h-[inherit] pt-20 pb-16 sm:pt-24 lg:pt-28 lg:pb-24' : 'py-20 sm:py-24 lg:py-28',
    ]}
  >
    <div class="max-w-3xl">
      <p class="eyebrow eyebrow-on-dark">{eyebrow}</p>
      {
        isHome ? (
          <h1 class="mt-5 text-4xl leading-[1.08] font-extrabold text-white sm:text-5xl lg:text-6xl">{title}</h1>
        ) : (
          <h1 class="mt-5 text-4xl leading-tight font-extrabold text-white sm:text-5xl">{title}</h1>
        )
      }
      <p class:list={['mt-6 max-w-2xl leading-relaxed text-ink-100/90', isHome ? 'text-lg sm:text-xl' : 'text-lg']}>
        {subtitle}
      </p>

      {
        chips.length > 0 && (
          <ul class="mt-8 flex flex-wrap gap-2" aria-label={eyebrow}>
            {chips.map((chip, i) => (
              <li class="inline-flex items-center gap-2 rounded-full border border-ice-300/30 bg-white/5 px-3.5 py-1.5 text-sm font-medium text-ice-300 backdrop-blur-sm">
                <Icon name={chipIcons[i % chipIcons.length]} class="size-4" />
                {chip}
              </li>
            ))}
          </ul>
        )
      }

      {
        (primaryCta || secondaryCta) && (
          <div class="mt-10 flex flex-col gap-3 sm:flex-row">
            {primaryCta && (
              <a href={primaryCta.href} class="btn btn-primary btn-lg">
                {primaryCta.label}
                <Icon name="arrowRight" class="size-5" />
              </a>
            )}
            {secondaryCta && (
              <a href={secondaryCta.href} class="btn btn-ghost-light btn-lg">
                {secondaryCta.label}
              </a>
            )}
          </div>
        )
      }
    </div>

    {
      stats.length > 0 && (
        <dl class="mt-14 grid max-w-3xl grid-cols-3 gap-4 border-t border-white/15 pt-8 sm:gap-8 lg:mt-20">
          {stats.map((s) => (
            <div class="flex flex-col-reverse gap-1">
              <dt class="text-xs leading-snug text-ink-200 sm:text-sm">{s.label}</dt>
              <dd class="font-display text-2xl font-extrabold text-gold-400 sm:text-4xl">{s.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</section>
