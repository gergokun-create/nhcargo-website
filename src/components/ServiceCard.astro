---
/** Teaser card for a service (home page). Links to the matching section on the Services page. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import type { IconName } from '../data/icons';

interface Props {
  icon: IconName;
  title: string;
  text: string;
  href: string;
  linkLabel: string;
  image: ImageMetadata;
  imageAlt: string;
  delay?: number;
}

const { icon, title, text, href, linkLabel, image, imageAlt, delay = 0 } = Astro.props;
---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-ink-100 bg-white shadow-[0_1px_2px_rgba(16,24,40,0.04)] transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-cold-800/10"
  data-reveal
  style={`--reveal-delay:${delay}ms`}
>
  <div class="relative aspect-[16/10] overflow-hidden">
    <Image
      src={image}
      alt={imageAlt}
      widths={[400, 640, 800]}
      sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
      format="webp"
      quality={70}
      class="h-full w-full object-cover transition duration-700 ease-out-soft group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink-950/50 to-transparent" aria-hidden="true"></div>
    <span
      class="absolute bottom-4 left-5 inline-flex size-12 items-center justify-center rounded-xl bg-white text-cold-700 shadow-lg"
    >
      <Icon name={icon} class="size-6" />
    </span>
  </div>
  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <h3 class="text-xl font-bold">
      <a href={href} class="after:absolute after:inset-0 focus-visible:outline-none">{title}</a>
    </h3>
    <p class="mt-3 flex-1 leading-relaxed text-ink-500">{text}</p>
    <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-cold-700" aria-hidden="true">
      {linkLabel}
      <Icon name="arrowRight" class="size-4 transition-transform group-hover:translate-x-1" />
    </span>
  </div>
  <span
    class="pointer-events-none absolute inset-0 rounded-2xl ring-ice-400 ring-offset-2 group-has-[:focus-visible]:ring-3"
    aria-hidden="true"></span>
</article>
