---
/**
 * Image with a visible placeholder: renders the uploaded photo for the slot,
 * or a dashed "image goes here" box (telling where to upload it in the admin) until one exists.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { aboutImage, aboutSlots, type AboutSlot } from '../data/aboutImages';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  slot: AboutSlot;
  class?: string;
}

const { lang, slot, class: className = '' } = Astro.props;
const t = useTranslations(lang).about;
const image = aboutImage(slot);
const { ratio, size } = aboutSlots[slot];
const label = t.slots[slot];
---

{
  image ? (
    <div class:list={['overflow-hidden rounded-3xl shadow-2xl shadow-ink-900/15', className]}>
      <Image
        src={image}
        alt={label.alt}
        widths={[480, 720, 960, 1200]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        format="webp"
        quality={70}
        class="h-full w-full object-cover"
        style={`aspect-ratio:${ratio}`}
      />
    </div>
  ) : (
    <div
      class:list={[
        'flex flex-col items-center justify-center gap-3 rounded-3xl border-2 border-dashed border-cold-600/40 bg-frost-100/70 p-6 text-center',
        className,
      ]}
      style={`aspect-ratio:${ratio}`}
      role="img"
      aria-label={`${t.placeholder.label}: ${label.title}`}
    >
      <span class="inline-flex size-14 items-center justify-center rounded-2xl bg-white text-cold-700 shadow-sm ring-1 ring-frost-200">
        <Icon name="image" class="size-7" />
      </span>
      <p class="font-display text-lg font-bold text-ink-800">
        {t.placeholder.label}: {label.title}
      </p>
      <p class="text-xs leading-relaxed text-ink-500">
        {t.placeholder.file} {label.title}
        <br />
        {t.placeholder.size}: {size}
      </p>
    </div>
  )
}
