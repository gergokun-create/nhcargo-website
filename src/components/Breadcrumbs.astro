---
/** Visible breadcrumb trail (the matching BreadcrumbList JSON-LD is added by BaseLayout). */
import Icon from './Icon.astro';
import { localePath, useTranslations, type Lang, type RouteKey } from '../i18n';

interface Props {
  lang: Lang;
  /** Trail below the home page; the last item is the current page. */
  trail: RouteKey[];
}

const { lang, trail } = Astro.props;
const t = useTranslations(lang);
const items: { key: RouteKey; label: string }[] = [
  { key: 'home', label: t.nav.home },
  ...trail.map((key) => ({ key, label: t.nav[key as Exclude<RouteKey, 'home'>] })),
];
const label = lang === 'hu' ? 'Morzsamenü' : 'Breadcrumb';
---

<nav aria-label={label} class="border-b border-ink-100 bg-white">
  <ol class="container-page flex flex-wrap items-center gap-x-2 gap-y-1 py-3.5 text-sm">
    {
      items.map((item, i) => {
        const last = i === items.length - 1;
        return (
          <li class="flex items-center gap-2">
            {i > 0 && <Icon name="arrowRight" class="size-3.5 text-ink-300" />}
            {last ? (
              <span aria-current="page" class="font-semibold text-ink-900">
                {item.label}
              </span>
            ) : (
              <a href={localePath(item.key, lang)} class="text-ink-500 underline-offset-4 hover:text-cold-700 hover:underline">
                {item.label}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
