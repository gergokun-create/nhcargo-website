---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  /** Heading level – keep the page outline correct (h1 is the hero). */
  as?: 'h2' | 'h3';
  dark?: boolean;
  id?: string;
}

const { eyebrow, title, intro, align = 'left', as: Tag = 'h2', dark = false, id } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']} data-reveal>
  {eyebrow && <p class:list={['eyebrow', dark && 'eyebrow-on-dark', align === 'center' && 'justify-center']}>{eyebrow}</p>}
  <Tag
    id={id}
    class:list={['mt-4 text-3xl leading-tight font-extrabold sm:text-4xl', dark ? 'text-white' : 'text-ink-900']}
  >
    {title}
  </Tag>
  {intro && <p class:list={['mt-5 text-lg leading-relaxed', dark ? 'text-ink-200' : 'text-ink-500']}>{intro}</p>}
</div>
