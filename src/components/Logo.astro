---
/**
 * NH Cargo logo (official vector file: src/assets/brand/nh-cargo-logo.svg).
 * To change the logo, replace that SVG file – header, footer and the About page use it.
 */
import logoUrl from '../assets/brand/nh-cargo-logo.svg?url';

interface Props {
  class?: string;
  size?: 'sm' | 'md' | 'lg';
  alt?: string;
}

const { class: className = '', size = 'md', alt = 'NH Cargo – Out of box' } = Astro.props;

// The logo is 3.32 : 1 (width : height)
const sizes = {
  sm: { cls: 'h-9', w: 120, h: 36 },
  md: { cls: 'h-11', w: 146, h: 44 },
  lg: { cls: 'h-16', w: 212, h: 64 },
}[size];
---

<img
  src={logoUrl}
  alt={alt}
  width={sizes.w}
  height={sizes.h}
  class:list={['block w-auto shrink-0', sizes.cls, className]}
  decoding="async"
/>
