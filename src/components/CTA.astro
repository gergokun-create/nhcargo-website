---
/** Final call-to-action band, shown at the bottom of most pages. */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { images } from '../data/images';
import { localePath, useTranslations, type Lang } from '../i18n';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative isolate overflow-hidden bg-ink-900" aria-labelledby="cta-title">
  <Image
    src={images.highwayMotion}
    alt=""
    widths={[640, 1280, 1920]}
    sizes="100vw"
    format="webp"
    quality={60}
    class="absolute inset-0 -z-20 h-full w-full object-cover opacity-40"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-cold-800/95 via-ink-900/90 to-ink-900/70" aria-hidden="true">
  </div>
  <div class="container-page py-20 sm:py-24">
    <div class="flex flex-col items-start gap-10 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-2xl" data-reveal>
        <h2 id="cta-title" class="text-3xl leading-tight font-extrabold text-white sm:text-4xl">{t.cta.title}</h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-100/90">{t.cta.text}</p>
      </div>
      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row lg:flex-col xl:flex-row" data-reveal style="--reveal-delay:120ms">
        <a href={localePath('contact', lang) + '#quote-form'} class="btn btn-primary btn-lg">
          {t.cta.primary}
          <Icon name="arrowRight" class="size-5" />
        </a>
        <a href={site.phone.href} class="btn btn-ghost-light btn-lg">
          <Icon name="phone" class="size-5" />
          {site.phone.display}
        </a>
      </div>
    </div>
  </div>
</section>
