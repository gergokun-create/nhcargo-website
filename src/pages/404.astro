---
/** Custom 404 page – bilingual, because the visitor's language is unknown here. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { localePath, useTranslations } from '../i18n';

const hu = useTranslations('hu');
const en = useTranslations('en');
---

<BaseLayout lang="hu" title={`${hu.notFound.title} | NH Cargo`} description={hu.notFound.text} noindex>
  <section class="relative isolate overflow-hidden bg-ink-900 text-white">
    <div class="pointer-events-none absolute -top-32 -left-32 size-[32rem] rounded-full bg-cold-700/30 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -right-32 -bottom-32 size-[28rem] rounded-full bg-gold-600/15 blur-3xl" aria-hidden="true"></div>
    <div class="container-page relative flex min-h-[70vh] flex-col items-center justify-center py-24 text-center">
      <span class="inline-flex size-20 items-center justify-center rounded-3xl bg-white/5 text-ice-300 ring-1 ring-white/10">
        <Icon name="snowflake" class="size-10" />
      </span>
      <p class="mt-8 font-display text-7xl font-extrabold text-gold-400 sm:text-8xl">404</p>

      <h1 class="mt-6 text-3xl font-extrabold text-white sm:text-4xl">{hu.notFound.title}</h1>
      <p class="mt-4 max-w-lg text-lg text-ink-200">{hu.notFound.text}</p>
      <a href={localePath('home', 'hu')} class="btn btn-primary btn-lg mt-8">
        {hu.common.backHome}
        <Icon name="arrowRight" class="size-5" />
      </a>

      <div lang="en" class="mt-14 border-t border-white/10 pt-8">
        <p class="text-xl font-bold text-white">{en.notFound.title}</p>
        <p class="mt-2 text-ink-300">{en.notFound.text}</p>
        <a href={localePath('home', 'en')} class="mt-4 inline-flex items-center gap-2 font-semibold text-ice-300 hover:text-white">
          {en.common.backHome}
          <Icon name="arrowRight" class="size-4" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
