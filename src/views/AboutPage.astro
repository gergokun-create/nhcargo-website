---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ImageSlot from '../components/ImageSlot.astro';
import CertBadges from '../components/CertBadges.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import { images } from '../data/images';
import { aboutImage } from '../data/aboutImages';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const a = t.about;

// Header background: uploaded "fejlec" photo, or a stock photo until one is added.
const heroImage = aboutImage('fejlec') ?? images.reeferTrailers;
const heroAlt = aboutImage('fejlec') ? a.slots.fejlec.alt : t.alt.reeferTrailers;
---

<BaseLayout lang={lang} page="about">
  <Hero eyebrow={a.hero.eyebrow} title={a.hero.title} subtitle={a.hero.subtitle} image={heroImage} imageAlt={heroAlt} />

  <!-- Company introduction -->
  <section class="section" aria-labelledby="intro-title">
    <div class="container-page grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div data-reveal>
        <p class="eyebrow">{a.hero.eyebrow}</p>
        <h2 id="intro-title" class="mt-4 text-3xl leading-tight font-extrabold sm:text-4xl">{a.intro.title}</h2>
        <p class="mt-6 text-lg leading-relaxed text-ink-500">{a.intro.text}</p>
        <dl class="mt-10 grid grid-cols-2 gap-4">
          {
            a.intro.stats.map((s) => (
              <div class="flex flex-col-reverse gap-1 rounded-2xl border border-ink-100 bg-white p-5 shadow-[0_1px_2px_rgba(16,24,40,0.04)]">
                <dt class="text-sm leading-snug text-ink-500">{s.label}</dt>
                <dd class="font-display text-3xl font-extrabold text-cold-700">{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div data-reveal style="--reveal-delay:120ms">
        <ImageSlot lang={lang} slot="csapat" />
      </div>
    </div>
  </section>

  <!-- Core business + fleet -->
  <section class="section bg-frost-50" aria-labelledby="activity-title">
    <div class="container-page grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div class="lg:order-2" data-reveal>
        <span class="inline-flex size-12 items-center justify-center rounded-xl bg-cold-700 text-white">
          <Icon name="truck" class="size-6" />
        </span>
        <h2 id="activity-title" class="mt-5 text-3xl leading-tight font-extrabold">{a.activity.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-500">{a.activity.text}</p>

        <h2 class="mt-12 text-3xl leading-tight font-extrabold">{a.fleet.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-500">{a.fleet.text}</p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {
            a.fleet.types.map((type) => (
              <li class="inline-flex items-center gap-2 rounded-full bg-white px-3.5 py-1.5 text-sm font-semibold text-cold-700 ring-1 ring-frost-200">
                <Icon name="snowflake" class="size-4" />
                {type}
              </li>
            ))
          }
        </ul>
        <ul class="mt-6 space-y-3">
          {
            a.fleet.badges.map((badge, i) => (
              <li class="flex items-center gap-3">
                <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-gold-500 text-ink-950">
                  <Icon name={i === 2 ? 'locate' : 'shield'} class="size-4" strokeWidth={2} />
                </span>
                <span class="font-semibold text-ink-800">{badge}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="lg:order-1" data-reveal style="--reveal-delay:120ms">
        <ImageSlot lang={lang} slot="flotta" />
      </div>
    </div>
  </section>

  <!-- Results -->
  <section class="section relative overflow-hidden bg-ink-900" aria-labelledby="results-title">
    <div class="pointer-events-none absolute -top-40 -left-40 size-[36rem] rounded-full bg-cold-700/25 blur-3xl" aria-hidden="true"></div>
    <div class="container-page relative">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow eyebrow-on-dark justify-center">{a.results.eyebrow}</p>
        <h2 id="results-title" class="mt-4 text-3xl leading-tight font-extrabold text-white sm:text-4xl">
          {a.results.title}
        </h2>
      </div>
      <dl class="mx-auto mt-14 grid max-w-4xl gap-6 sm:grid-cols-2">
        {
          a.results.items.map((item, i) => (
            <div
              class="flex flex-col-reverse gap-2 rounded-2xl border border-white/10 bg-white/[0.04] p-8 text-center"
              data-reveal
              style={`--reveal-delay:${i * 90}ms`}
            >
              <dt class="text-sm leading-snug text-ink-200 sm:text-base">{item.label}</dt>
              <dd class="font-display text-4xl font-extrabold whitespace-nowrap text-gold-400 sm:text-5xl">{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Quality management -->
  <section class="section" aria-labelledby="quality-title">
    <div class="container-page grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div data-reveal>
        <span class="inline-flex size-12 items-center justify-center rounded-xl bg-cold-700 text-white">
          <Icon name="award" class="size-6" />
        </span>
        <h2 id="quality-title" class="mt-5 text-3xl leading-tight font-extrabold sm:text-4xl">{a.quality.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-500">{a.quality.text}</p>
      </div>
      <div data-reveal style="--reveal-delay:120ms">
        <div class="rounded-3xl bg-frost-50 p-6 ring-1 ring-frost-200 sm:p-10">
          <CertBadges lang={lang} />
        </div>
      </div>
    </div>
  </section>

  <!-- Storage + on-call service -->
  <section class="section bg-frost-50" aria-labelledby="warehouse-title">
    <div class="container-page grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div class="lg:order-2 space-y-6">
        <article class="rounded-2xl border border-ink-100 bg-white p-7 shadow-[0_1px_2px_rgba(16,24,40,0.04)]" data-reveal>
          <span class="inline-flex size-12 items-center justify-center rounded-xl bg-frost-100 text-cold-700 ring-1 ring-frost-200">
            <Icon name="warehouse" class="size-6" />
          </span>
          <h2 id="warehouse-title" class="mt-5 text-2xl font-extrabold">{a.warehouse.title}</h2>
          <p class="mt-3 leading-relaxed text-ink-500">{a.warehouse.text}</p>
        </article>
        <article class="rounded-2xl border border-ink-100 bg-white p-7 shadow-[0_1px_2px_rgba(16,24,40,0.04)]" data-reveal style="--reveal-delay:90ms">
          <span class="inline-flex size-12 items-center justify-center rounded-xl bg-frost-100 text-cold-700 ring-1 ring-frost-200">
            <Icon name="clock" class="size-6" />
          </span>
          <h2 class="mt-5 text-2xl font-extrabold">{a.duty.title}</h2>
          <p class="mt-3 leading-relaxed text-ink-500">{a.duty.text}</p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {
              a.duty.hours.map((h) => (
                <li class="inline-flex items-center gap-2 rounded-full bg-gold-50 px-3.5 py-1.5 text-sm font-semibold text-gold-800 ring-1 ring-gold-200">
                  <Icon name="calendar" class="size-4" />
                  {h}
                </li>
              ))
            }
          </ul>
        </article>
      </div>
      <div class="lg:order-1" data-reveal style="--reveal-delay:120ms">
        <ImageSlot lang={lang} slot="raktar" />
      </div>
    </div>
  </section>

  <!-- Strength + goals -->
  <section class="section" aria-labelledby="strength-title">
    <div class="container-page grid gap-6 lg:grid-cols-2">
      <article class="rounded-3xl border-l-4 border-gold-500 bg-gold-50 p-8 sm:p-10" data-reveal>
        <Icon name="sparkles" class="size-8 text-gold-700" />
        <h2 id="strength-title" class="mt-5 text-2xl font-extrabold sm:text-3xl">{a.strength.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-600">{a.strength.text}</p>
      </article>
      <article class="rounded-3xl bg-ink-800 p-8 text-white sm:p-10" data-reveal style="--reveal-delay:90ms">
        <Icon name="target" class="size-8 text-ice-300" />
        <h2 class="mt-5 text-2xl font-extrabold text-white sm:text-3xl">{a.goals.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-200">{a.goals.text}</p>
      </article>
    </div>
  </section>

  <CTA lang={lang} />
</BaseLayout>
