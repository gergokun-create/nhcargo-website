---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContactForm from '../components/ContactForm.astro';
import MapEmbed from '../components/MapEmbed.astro';
import Icon from '../components/Icon.astro';
import { images } from '../data/images';
import { site, formatAddress } from '../data/site';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const d = t.contact.details;

const details = [
  { icon: 'building', label: d.company, value: site.name },
  { icon: 'phone', label: d.phone, value: site.phone.display, href: site.phone.href },
  { icon: 'mail', label: d.email, value: site.email, href: `mailto:${site.email}` },
  { icon: 'mapPin', label: d.office, value: formatAddress(site.office) },
  { icon: 'building', label: d.seat, value: formatAddress(site.seat) },
] as const;
---

<BaseLayout lang={lang} page="contact">
  <Hero
    eyebrow={t.contact.hero.eyebrow}
    title={t.contact.hero.title}
    subtitle={t.contact.hero.subtitle}
    image={images.logisticsHall}
    imageAlt={t.alt.logisticsHall}
  />

  <section class="section bg-frost-50">
    <div class="container-page grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="space-y-8 lg:col-span-5">
        <div class="rounded-3xl bg-ink-800 p-7 text-white shadow-xl sm:p-9" data-reveal>
          <h2 class="text-2xl font-bold text-white">{d.title}</h2>
          <dl class="mt-8 space-y-6">
            {
              details.map((item) => (
                <div class="flex gap-4">
                  <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-white/10 text-gold-400">
                    <Icon name={item.icon} class="size-5" />
                  </span>
                  <div>
                    <dt class="text-xs font-semibold tracking-wider text-ink-300 uppercase">{item.label}</dt>
                    <dd class="mt-1 text-base font-medium text-white">
                      {'href' in item ? (
                        <a href={item.href} class="transition-colors hover:text-gold-300">
                          {item.value}
                        </a>
                      ) : (
                        item.value
                      )}
                    </dd>
                  </div>
                </div>
              ))
            }
          </dl>
        </div>

        <div data-reveal>
          <h2 class="mb-4 text-xl font-bold">{t.contact.map.title}</h2>
          <MapEmbed lang={lang} />
        </div>
      </div>

      <div id="quote-form" class="scroll-mt-24 lg:col-span-7" aria-labelledby="quote-form-title">
        <div class="rounded-3xl border border-ink-100 bg-white p-6 shadow-xl shadow-cold-800/5 sm:p-10" data-reveal>
          <h2 id="quote-form-title" class="text-3xl font-extrabold">{t.form.title}</h2>
          <div class="mt-6">
            <ContactForm lang={lang} />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
