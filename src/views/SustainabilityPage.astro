---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureCard from '../components/FeatureCard.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import { images } from '../data/images';
import { sustainabilityPillars } from '../data/content';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const s = t.sustainability;
---

<BaseLayout lang={lang} page="sustainability">
  <Hero
    eyebrow={s.hero.eyebrow}
    title={s.hero.title}
    subtitle={s.hero.subtitle}
    image={images.highwayInterchange}
    imageAlt={t.alt.highwayInterchange}
  />

  <section class="section" aria-labelledby="commitment-title">
    <div class="container-page grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionHeading eyebrow={s.intro.eyebrow} title={s.intro.title} id="commitment-title" />
        <div class="mt-6 space-y-5 text-lg leading-relaxed text-ink-500" data-reveal>
          {s.intro.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div data-reveal>
        <div class="overflow-hidden rounded-3xl shadow-2xl shadow-ink-900/10">
          <Image
            src={images.windTurbines}
            alt={t.alt.windTurbines}
            widths={[480, 720, 960, 1200]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            format="webp"
            quality={72}
            class="aspect-[4/3] w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-frost-50 pt-0 sm:pt-0 lg:pt-0" aria-labelledby="pillars-title">
    <div class="container-page pt-20 sm:pt-24">
      <SectionHeading title={s.pillarsTitle} align="center" id="pillars-title" />
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          sustainabilityPillars.map((p, i) => (
            <FeatureCard
              icon={p.icon}
              title={s.pillars[p.id].title}
              text={s.pillars[p.id].text}
              tone="green"
              delay={i * 90}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="closing-title">
    <div class="container-page">
      <div
        class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-emerald-900 via-cold-800 to-ink-900 px-6 py-14 text-center sm:px-12 sm:py-20"
        data-reveal
      >
        <Icon name="leaf" class="mx-auto size-12 text-emerald-300" />
        <h2 id="closing-title" class="mx-auto mt-6 max-w-2xl text-3xl font-extrabold text-white sm:text-4xl">
          {s.closing.title}
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-emerald-50/90">{s.closing.text}</p>
      </div>
    </div>
  </section>

  <CTA lang={lang} />
</BaseLayout>
